{
  "manifest_version": 3,
  "name": "刷之前想一下",
  "version": "0.6.0",
  "description": "进入前停一下，按自己选择的时间离开。支持可选的 WebDAV 设置与记录同步。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "webNavigation"],
  "host_permissions": [
    "*://*.douyin.com/*",
    "*://*.xiaohongshu.com/*",
    "*://*.bilibili.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none';"
  },
  "action": { "default_title": "刷之前想一下 · 记录与设置" },
  "options_page": "journal.html",
  "content_scripts": [{
    "matches": ["*://*.douyin.com/*", "*://*.xiaohongshu.com/*", "*://*.bilibili.com/*"],
    "js": ["expiry.js", "timer.js"],
    "run_at": "document_start"
  }]
}
